# Copy this file to .env, then paste your Claude API key after the = sign.
# Get a key in the Claude Console (platform.claude.com); choose "Somewhere else" when it asks where your code runs.
# On your own computer you can skip the key: run `ant auth login` once instead.
# Never put the key in the web page or commit it to GitHub. On a hosting service, add it in the host's settings.
ANTHROPIC_API_KEY=

# Optional: the port the site runs on (default 3000)
# PORT=3000
